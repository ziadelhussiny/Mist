<section class="mista-hero" style="--mista-hero-min:{{ section.settings.height }}px;--mista-image-position:{{ section.settings.image_position }};--mista-overlay:{{ section.settings.overlay | divided_by: 100.0 }}">
  <div class="mista-hero__media">
    {% if section.settings.desktop_image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}<source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}
        {{ section.settings.desktop_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1000,1400,1800,2200,2400', sizes: '100vw', alt: section.settings.image_alt }}
      </picture>
    {% else %}<picture><source media="(max-width: 767px)" srcset="{{ 'mista-hero-mobile-480.webp' | asset_url }} 480w, {{ 'mista-hero-mobile-800.webp' | asset_url }} 800w, {{ 'mista-hero-mobile.webp' | asset_url }} 1122w" sizes="100vw"><img src="{{ 'mista-hero-desktop-1440.webp' | asset_url }}" srcset="{{ 'mista-hero-desktop-960.webp' | asset_url }} 960w, {{ 'mista-hero-desktop-1440.webp' | asset_url }} 1440w, {{ 'mista-hero-desktop.webp' | asset_url }} 1672w" sizes="100vw" width="1672" height="940" loading="eager" fetchpriority="high" decoding="sync" alt="{{ section.settings.image_alt | escape }}"></picture>{% endif %}
  </div>
  <div class="mista-hero__overlay"></div>
  <div class="mista-hero__content">
    <div class="mista-hero__content-inner" style="text-align:{{ section.settings.alignment }}">
      {% if section.settings.eyebrow != blank %}<p class="mista-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1 class="mista-heading">{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}<div class="mista-copy">{{ section.settings.text }}</div>{% endif %}
      <div class="mista-hero__actions">
        {% if section.settings.button_label != blank %}<a class="mista-button mista-button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="mista-button mista-button--outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Mista hero banner",
  "tag": "section",
  "class": "mista-hero-section",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop banner image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile banner image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Mista perfume collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A scent for every you" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover signature fragrance collections, crafted for every mood and every moment.</p>" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Explore collections" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 420, "max": 820, "step": 20, "unit": "px", "default": 600 },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left center", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right center", "label": "Right" }], "default": "center" },
    { "type": "select", "id": "alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "overlay", "label": "Overlay strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 90 }
  ],
  "presets": [{ "name": "Mista hero banner" }]
}
{% endschema %}
