<section class="mista-story" style="background:{{ section.settings.background }}">
  <div class="mista-story__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width:768px) 50vw, 100vw', alt: section.settings.image_alt }}{% else %}<img src="{{ 'mista-product-black-640.webp' | asset_url }}" srcset="{{ 'mista-product-black-360.webp' | asset_url }} 360w, {{ 'mista-product-black-640.webp' | asset_url }} 640w, {{ 'mista-product-black-900.webp' | asset_url }} 900w, {{ 'mista-product-black.webp' | asset_url }} 1122w" sizes="(min-width:768px) 50vw, 100vw" width="1122" height="1402" loading="lazy" decoding="async" alt="{{ section.settings.image_alt | escape }}">{% endif %}</div>
  <div class="mista-story__content" style="text-align:{{ section.settings.alignment }}"><p class="mista-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.heading }}</h2><div class="mista-copy">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="mista-button mista-button--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div>
</section>
{% schema %}
{
  "name": "Mista about story",
  "tag": "section",
  "class": "mista-about-story-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Story image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Black Mista perfume bottle with gold monogram" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Crafted with purpose" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to become part of you" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We balance expressive notes, considered ingredients, and precise craftsmanship to create lasting fragrances with presence and character. As an online-only house, every touchpoint is designed around a thoughtful, direct relationship with our customers.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Mista about story" }]
}
{% endschema %}
