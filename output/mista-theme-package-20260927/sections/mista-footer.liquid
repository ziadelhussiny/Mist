<section class="mista-footer">
  <div class="mista-shell">
    <div class="mista-footer__grid">
      <div class="mista-footer__brand"><span class="mista-monogram" aria-hidden="true">M</span><strong class="mista-wordmark">MISTA</strong><p>{{ section.settings.description }}</p></div>
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}><h3>{{ block.settings.heading }}</h3><ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div>
      {% endfor %}
    </div>
    <div class="mista-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright }}</span>
      <div class="mista-footer__socials">
        {% if settings.mista_instagram != blank %}<a href="{{ settings.mista_instagram }}">Instagram</a>{% endif %}
        {% if settings.mista_facebook != blank %}<a href="{{ settings.mista_facebook }}">Facebook</a>{% endif %}
        {% if settings.mista_tiktok != blank %}<a href="{{ settings.mista_tiktok }}">TikTok</a>{% endif %}
        {% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endif %}{% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Mista footer",
  "tag": "section",
  "class": "mista-footer-section",
  "limit": 1,
  "settings": [
    { "type": "textarea", "id": "description", "label": "Brand description", "default": "Modern fragrance, thoughtfully composed. Mista is an online-only perfume house made for everyday rituals." },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "All rights reserved." }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "limit": 3, "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop" }, { "type": "link_list", "id": "menu", "label": "Menu" }] }
  ],
  "presets": [{ "name": "Mista footer", "blocks": [{ "type": "menu" }, { "type": "menu" }, { "type": "menu" }] }]
}
{% endschema %}
