<section class="mista-banner" style="--mista-banner-height:{{ section.settings.height }}px;--mista-banner-mobile-height:{{ section.settings.mobile_height }}px;--mista-image-position:{{ section.settings.image_position }}">
  <div class="mista-banner__media">
    {% if section.settings.desktop_image != blank %}<picture>{% if section.settings.mobile_image != blank %}<source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 480 }} 480w, {{ section.settings.mobile_image | image_url: width: 800 }} 800w, {{ section.settings.mobile_image | image_url: width: 1122 }} 1122w" sizes="100vw">{% endif %}{{ section.settings.desktop_image | image_url: width: 1672 | image_tag: loading: 'lazy', widths: '960,1440,1672', sizes: '100vw', alt: section.settings.image_alt }}</picture>{% else %}<picture><source media="(max-width: 767px)" srcset="{{ 'mista-promo-mobile-480.webp' | asset_url }} 480w, {{ 'mista-promo-mobile-800.webp' | asset_url }} 800w, {{ 'mista-promo-mobile.webp' | asset_url }} 1122w" sizes="100vw"><img src="{{ 'mista-promo-desktop-1440.webp' | asset_url }}" srcset="{{ 'mista-promo-desktop-960.webp' | asset_url }} 960w, {{ 'mista-promo-desktop-1440.webp' | asset_url }} 1440w, {{ 'mista-promo-desktop.webp' | asset_url }} 1672w" sizes="100vw" width="1672" height="940" loading="lazy" decoding="async" alt="{{ section.settings.image_alt | escape }}"></picture>{% endif %}
  </div>
  <div class="mista-banner__overlay" style="opacity:{{ section.settings.overlay | divided_by: 100.0 }}"></div>
  <div class="mista-banner__content"><div><p class="mista-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.heading }}</h2><div class="mista-copy">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="mista-button mista-button--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></div>
</section>
{% schema %}
{
  "name": "Mista promotional banner",
  "tag": "section",
  "class": "mista-promo-banner-section",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop banner image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile banner image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Mista fragrance promotional collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Elevate your everyday" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Luxury fragrance. Lasting impressions." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover a scent designed to become part of your story.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 260, "max": 650, "step": 10, "unit": "px", "default": 390 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 320, "max": 680, "step": 10, "unit": "px", "default": 460 },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left center", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right center", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "overlay", "label": "Overlay strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "Mista promotional banner" }]
}
{% endschema %}
