{% liquid
  assign icon_name = name | default: 'sparkle'
%}
<svg class="mista-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true" focusable="false">
  {% case icon_name %}
    {% when 'menu' %}<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {% when 'search' %}<circle cx="10.5" cy="10.5" r="6" stroke="currentColor" stroke-width="1.6"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    {% when 'heart' %}<path d="M20.8 5.8c-2-2.2-5.4-1.7-6.9.7L12 9.3l-1.9-2.8C8.6 4.1 5.2 3.6 3.2 5.8c-2.1 2.3-1.8 5.9.4 8.1L12 22l8.4-8.1c2.2-2.2 2.5-5.8.4-8.1Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    {% when 'bag' %}<path d="M5 8h14l-1 13H6L5 8Z" stroke="currentColor" stroke-width="1.5"/><path d="M9 9V6a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.5"/>
    {% when 'truck' %}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z" stroke="currentColor" stroke-width="1.4"/><circle cx="7" cy="18" r="2" stroke="currentColor" stroke-width="1.4"/><circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.4"/>
    {% when 'shield' %}<path d="M12 2 4.5 5v6.2c0 4.7 3.1 8.9 7.5 10.8 4.4-1.9 7.5-6.1 7.5-10.8V5L12 2Z" stroke="currentColor" stroke-width="1.4"/><path d="m8.5 12 2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.4"/>
    {% when 'return' %}<path d="M4 8v5h5M4.5 13A8 8 0 1 0 7 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'leaf' %}<path d="M19.5 4.5C11 4.5 5 8 5 15c0 2.5 1.5 4.5 4 4.5 7 0 10.5-6 10.5-15Z" stroke="currentColor" stroke-width="1.4"/><path d="M4 21c3-6 7-8 12-11" stroke="currentColor" stroke-width="1.4"/>
    {% when 'star' %}<path d="m12 2.8 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 2.8Z" fill="currentColor"/>
    {% when 'minus' %}<path d="M5 12h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {% when 'plus' %}<path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {% when 'chevron' %}<path d="m8 10 4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    {% else %}<path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1"/>
  {% endcase %}
</svg>
