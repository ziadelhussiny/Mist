<section class="mista-section" style="--mista-section-bg:{{ section.settings.background }};--mista-columns:{{ section.settings.columns }};--mista-gap:{{ section.settings.gap }}px">
  <div class="mista-shell"><header class="mista-section-head mista-section-head--center"><p class="mista-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.heading }}</h2>{% if section.settings.text != blank %}<div class="mista-copy" style="margin-inline:auto">{{ section.settings.text }}</div>{% endif %}</header>
    <div class="mista-social-grid">{% for block in section.blocks %}{% liquid
      case forloop.index
        when 1
          assign default_social_color = 'black'
        when 2
          assign default_social_color = 'pink'
        when 3
          assign default_social_color = 'orange'
        when 4
          assign default_social_color = 'turquoise'
        else
          assign default_social_color = 'black'
      endcase
      assign default_social_image = 'mista-product-' | append: default_social_color | append: '-640.webp'
      assign default_social_image_360 = 'mista-product-' | append: default_social_color | append: '-360.webp'
      assign default_social_image_640 = 'mista-product-' | append: default_social_color | append: '-640.webp'
      assign default_social_image_900 = 'mista-product-' | append: default_social_color | append: '-900.webp'
      assign default_social_image_full = 'mista-product-' | append: default_social_color | append: '.webp'
    %}<a class="mista-social-card" href="{{ block.settings.link | default: settings.mista_instagram }}" {% if block.settings.link != blank %}target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240,360,540,720,900', sizes: '(min-width: 768px) 20vw, 50vw', alt: block.settings.alt }}{% else %}<img src="{{ default_social_image | asset_url }}" srcset="{{ default_social_image_360 | asset_url }} 360w, {{ default_social_image_640 | asset_url }} 640w, {{ default_social_image_900 | asset_url }} 900w, {{ default_social_image_full | asset_url }} 1122w" sizes="(min-width: 768px) 20vw, 50vw" width="1122" height="1402" loading="lazy" decoding="async" alt="{{ block.settings.alt | escape }}">{% endif %}<span class="visually-hidden">View Mista on social media</span></a>{% endfor %}</div>
  </div>
</section>
{% schema %}
{
  "name": "Mista social gallery",
  "tag": "section",
  "class": "mista-social-gallery-section",
  "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@mistaperfume" }, { "type": "text", "id": "heading", "label": "Heading", "default": "The Mista mood" }, { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Follow the rituals, stories, and scents shaping our world.</p>" }, { "type": "range", "id": "columns", "label": "Desktop columns", "min": 3, "max": 6, "step": 1, "default": 5 }, { "type": "range", "id": "gap", "label": "Grid gap", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 }, { "type": "color", "id": "background", "label": "Background", "default": "#F7F1E8" }],
  "blocks": [{ "type": "image", "name": "Social image", "limit": 10, "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "alt", "label": "Alt text", "default": "Mista perfume lifestyle" }, { "type": "url", "id": "link", "label": "Post link" }] }],
  "presets": [{ "name": "Mista social gallery", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
