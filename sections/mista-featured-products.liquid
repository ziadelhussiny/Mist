{% assign featured_collection = section.settings.collection %}
{% if featured_collection == blank or featured_collection.products_count == 0 %}
  {% assign featured_collection = collections.all %}
{% endif %}
<section class="mista-section" style="--mista-section-bg:{{ section.settings.background }};--mista-gap:{{ section.settings.gap }}px">
  <div class="mista-shell">
    <header class="mista-section-head"><div><p class="mista-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.heading }}</h2></div>{% if featured_collection != blank %}<a class="mista-button mista-button--outline" href="{{ featured_collection.url }}">{{ section.settings.button_label }}</a>{% endif %}</header>
    <div class="mista-product-grid" style="--mista-columns:{{ section.settings.columns }}">
      {% for product in featured_collection.products limit: section.settings.products_to_show %}{% render 'mista-product-card', product: product %}{% else %}{% for i in (1..4) %}{% liquid
        case i
          when 1
            assign preview_color = 'black'
            assign preview_title = 'Noir Intense'
          when 2
            assign preview_color = 'pink'
            assign preview_title = 'Rose Allure'
          when 3
            assign preview_color = 'orange'
            assign preview_title = 'Oud Elegance'
          else
            assign preview_color = 'turquoise'
            assign preview_title = 'Citrus Bleu'
        endcase
        assign preview_image = 'mista-product-' | append: preview_color | append: '-640.webp'
        assign preview_image_360 = 'mista-product-' | append: preview_color | append: '-360.webp'
        assign preview_image_640 = 'mista-product-' | append: preview_color | append: '-640.webp'
        assign preview_image_900 = 'mista-product-' | append: preview_color | append: '-900.webp'
        assign preview_image_full = 'mista-product-' | append: preview_color | append: '.webp'
      %}<article class="mista-product-card"><div class="mista-product-card__media"><img class="mista-product-card__image" src="{{ preview_image | asset_url }}" srcset="{{ preview_image_360 | asset_url }} 360w, {{ preview_image_640 | asset_url }} 640w, {{ preview_image_900 | asset_url }} 900w, {{ preview_image_full | asset_url }} 1122w" sizes="(min-width: 990px) 25vw, 50vw" width="1122" height="1402" loading="lazy" decoding="async" alt="{{ preview_title }} Mista perfume bottle with gold monogram"></div><div class="mista-product-card__body"><span class="mista-product-card__title">{{ preview_title }}</span><div class="mista-stars">★★★★★</div><div class="mista-price"><strong>{{ 5500 | money }}</strong></div><span class="mista-button mista-button--primary mista-button--compact">Add to cart</span></div></article>{% endfor %}{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Mista featured products",
  "tag": "section",
  "class": "mista-featured-products-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Most loved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop all" },
    { "type": "range", "id": "products_to_show", "label": "Products", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "gap", "label": "Grid gap", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "color", "id": "background", "label": "Background", "default": "#F7F1E8" }
  ],
  "presets": [{ "name": "Mista featured products" }]
}
{% endschema %}
