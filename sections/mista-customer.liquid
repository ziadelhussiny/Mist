<section class="mista-section">
  <div class="mista-shell" style="max-width:{% if template.name == 'account' or template.name == 'order' or template.name == 'addresses' %}1100px{% else %}620px{% endif %}">
    {% case template.name %}
      {% when 'login' %}
        <header class="mista-section-head mista-section-head--center"><p class="mista-eyebrow">Welcome back</p><h1 class="mista-heading mista-heading--section">Sign in</h1></header>
        {% form 'customer_login', class: 'mista-form' %}{{ form.errors | default_errors }}<div class="mista-field mista-field--full"><label for="CustomerEmail">Email</label><input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required></div><div class="mista-field mista-field--full"><label for="CustomerPassword">Password</label><input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required></div><button class="mista-button mista-button--primary mista-field--full" type="submit">Sign in</button><a href="{{ routes.account_register_url }}">Create account</a>{% endform %}
        <div style="margin-top:48px"><h2 class="mista-heading mista-heading--section" style="font-size:1.6rem">Recover password</h2>{% form 'recover_customer_password', class: 'mista-form' %}{{ form.errors | default_errors }}<div class="mista-field mista-field--full"><label for="RecoverEmail">Email</label><input id="RecoverEmail" type="email" name="email" autocomplete="email" required></div><button class="mista-button mista-button--outline mista-field--full" type="submit">Send reset link</button>{% endform %}</div>
      {% when 'register' %}
        <header class="mista-section-head mista-section-head--center"><p class="mista-eyebrow">Join Mista</p><h1 class="mista-heading mista-heading--section">Create account</h1></header>
        {% form 'create_customer', class: 'mista-form' %}{{ form.errors | default_errors }}<div class="mista-field"><label for="RegisterFirst">First name</label><input id="RegisterFirst" name="customer[first_name]" autocomplete="given-name"></div><div class="mista-field"><label for="RegisterLast">Last name</label><input id="RegisterLast" name="customer[last_name]" autocomplete="family-name"></div><div class="mista-field mista-field--full"><label for="RegisterEmail">Email</label><input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required></div><div class="mista-field mista-field--full"><label for="RegisterPassword">Password</label><input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required></div><button class="mista-button mista-button--primary mista-field--full" type="submit">Create account</button>{% endform %}
      {% when 'activate_account' %}
        <header class="mista-section-head mista-section-head--center"><h1 class="mista-heading mista-heading--section">Activate account</h1></header>{% form 'activate_customer_password', class: 'mista-form' %}{{ form.errors | default_errors }}<div class="mista-field mista-field--full"><label for="ActivatePassword">Password</label><input id="ActivatePassword" type="password" name="customer[password]" required></div><div class="mista-field mista-field--full"><label for="ActivateConfirm">Confirm password</label><input id="ActivateConfirm" type="password" name="customer[password_confirmation]" required></div><button class="mista-button mista-button--primary" type="submit">Activate</button><button class="mista-button mista-button--outline" type="submit" name="decline">Decline</button>{% endform %}
      {% when 'reset_password' %}
        <header class="mista-section-head mista-section-head--center"><h1 class="mista-heading mista-heading--section">Reset password</h1></header>{% form 'reset_customer_password', class: 'mista-form' %}{{ form.errors | default_errors }}<div class="mista-field mista-field--full"><label for="ResetPassword">Password</label><input id="ResetPassword" type="password" name="customer[password]" required></div><div class="mista-field mista-field--full"><label for="ResetConfirm">Confirm password</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" required></div><button class="mista-button mista-button--primary mista-field--full" type="submit">Reset password</button>{% endform %}
      {% when 'account' %}
        <header class="mista-section-head"><div><p class="mista-eyebrow">Your Mista</p><h1 class="mista-heading mista-heading--section">Account</h1></div><a class="mista-button mista-button--outline" href="{{ routes.account_logout_url }}">Sign out</a></header><p>{{ customer.name }} · {{ customer.email }}</p><a class="mista-button mista-button--outline" href="{{ routes.account_addresses_url }}">Manage addresses</a><div style="margin-top:38px"><h2 class="mista-heading mista-heading--section" style="font-size:1.8rem">Order history</h2>{% if customer.orders.size > 0 %}{% for order in customer.orders %}<div class="mista-summary-line" style="padding-block:14px;border-bottom:1px solid var(--mista-border)"><a href="{{ order.customer_url }}">{{ order.name }}</a><span>{{ order.created_at | date: '%B %d, %Y' }}</span><strong>{{ order.total_price | money }}</strong></div>{% endfor %}{% else %}<p class="mista-copy">No orders yet.</p>{% endif %}</div>
      {% when 'order' %}
        <header class="mista-section-head"><div><p class="mista-eyebrow">{{ order.created_at | date: '%B %d, %Y' }}</p><h1 class="mista-heading mista-heading--section">Order {{ order.name }}</h1></div><a class="mista-button mista-button--outline" href="{{ routes.account_url }}">Back to account</a></header>{% for line_item in order.line_items %}<div class="mista-summary-line" style="padding-block:14px;border-bottom:1px solid var(--mista-border)"><span>{{ line_item.title }} × {{ line_item.quantity }}</span><strong>{{ line_item.final_line_price | money }}</strong></div>{% endfor %}<div class="mista-summary-line mista-summary-line--total"><span>Total</span><strong>{{ order.total_price | money }}</strong></div>
      {% when 'addresses' %}
        <header class="mista-section-head"><div><p class="mista-eyebrow">Account</p><h1 class="mista-heading mista-heading--section">Addresses</h1></div><a class="mista-button mista-button--outline" href="{{ routes.account_url }}">Back to account</a></header>{% for address in customer.addresses %}<article class="mista-editorial-card" style="margin-bottom:16px">{{ address | format_address }}<form method="post" action="/account/addresses/{{ address.id }}"><input type="hidden" name="_method" value="delete"><button class="mista-button mista-button--outline" type="submit">Delete</button></form></article>{% endfor %}{% form 'customer_address', customer.new_address, class: 'mista-form' %}<div class="mista-field"><label for="AddressFirst">First name</label><input id="AddressFirst" name="address[first_name]"></div><div class="mista-field"><label for="AddressLast">Last name</label><input id="AddressLast" name="address[last_name]"></div><div class="mista-field mista-field--full"><label for="AddressStreet">Address</label><input id="AddressStreet" name="address[address1]"></div><div class="mista-field"><label for="AddressCity">City</label><input id="AddressCity" name="address[city]"></div><div class="mista-field"><label for="AddressCountry">Country</label><select id="AddressCountry" name="address[country]">{{ all_country_option_tags }}</select></div><div class="mista-field"><label for="AddressZip">Postal code</label><input id="AddressZip" name="address[zip]"></div><div class="mista-field"><label for="AddressPhone">Phone</label><input id="AddressPhone" name="address[phone]"></div><button class="mista-button mista-button--primary mista-field--full" type="submit">Add address</button>{% endform %}
    {% endcase %}
  </div>
</section>
{% schema %}
{ "name": "Mista customer account", "tag": "section", "class": "mista-customer-section", "settings": [] }
{% endschema %}
