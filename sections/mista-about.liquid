<section>
  <div class="mista-editorial-hero">
    <div class="mista-editorial-hero__media">{% if section.settings.hero_desktop_image != blank %}<picture>{% if section.settings.hero_mobile_image != blank %}<source media="(max-width: 767px)" srcset="{{ section.settings.hero_mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.hero_desktop_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: section.settings.hero_alt }}</picture>{% else %}<div class="mista-hero__fallback" aria-hidden="true"></div>{% endif %}</div><div class="mista-editorial-hero__overlay"></div><div class="mista-editorial-hero__content"><div><p class="mista-eyebrow">{{ section.settings.hero_eyebrow }}</p><h1 class="mista-heading">{{ section.settings.hero_heading }}</h1><div class="mista-copy">{{ section.settings.hero_text }}</div></div></div>
  </div>
  <div class="mista-story"><div class="mista-story__media">{% if section.settings.story_image != blank %}{{ section.settings.story_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 768px) 50vw, 100vw', alt: section.settings.story_alt }}{% else %}<div class="mista-story__placeholder"></div>{% endif %}</div><div class="mista-story__content"><p class="mista-eyebrow">{{ section.settings.story_eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.story_heading }}</h2><div class="mista-copy">{{ section.settings.story_text }}</div></div></div>
  <div class="mista-section"><div class="mista-shell"><header class="mista-section-head mista-section-head--center"><p class="mista-eyebrow">{{ section.settings.values_eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.values_heading }}</h2></header><div class="mista-editorial-grid" style="--mista-columns:3">{% for block in section.blocks %}<article class="mista-editorial-card" {{ block.shopify_attributes }}>{% render 'mista-icon', name: block.settings.icon %}<h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div></div>
  <div class="mista-banner" style="--mista-banner-height:{{ section.settings.banner_height }}px;--mista-banner-mobile-height:{{ section.settings.banner_mobile_height }}px"><div class="mista-banner__media">{% if section.settings.banner_desktop_image != blank %}<picture>{% if section.settings.banner_mobile_image != blank %}<source media="(max-width: 767px)" srcset="{{ section.settings.banner_mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.banner_desktop_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: section.settings.banner_alt }}</picture>{% else %}<div class="mista-banner__fallback"></div>{% endif %}</div><div class="mista-banner__overlay"></div><div class="mista-banner__content"><div><p class="mista-eyebrow">{{ section.settings.banner_eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.banner_heading }}</h2><div class="mista-copy">{{ section.settings.banner_text }}</div><a class="mista-button mista-button--gold" href="{{ section.settings.banner_link }}">{{ section.settings.banner_label }}</a></div></div></div>
</section>
{% schema %}
{
  "name": "Mista about page",
  "tag": "section",
  "class": "mista-about-section",
  "settings": [
    { "type": "header", "content": "About hero" },
    { "type": "image_picker", "id": "hero_desktop_image", "label": "Desktop hero image" },
    { "type": "image_picker", "id": "hero_mobile_image", "label": "Mobile hero image" },
    { "type": "text", "id": "hero_alt", "label": "Hero alt text", "default": "Mista perfume artistry" },
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "Our story" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "The art of perfumery" },
    { "type": "richtext", "id": "hero_text", "label": "Hero text", "default": "<p>A modern perfume house creating fragrances that feel personal, expressive, and beautifully made.</p>" },
    { "type": "header", "content": "Story" },
    { "type": "image_picker", "id": "story_image", "label": "Story image" },
    { "type": "text", "id": "story_alt", "label": "Story image alt", "default": "Mista fragrance craftsmanship" },
    { "type": "text", "id": "story_eyebrow", "label": "Story eyebrow", "default": "Crafted with purpose" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "Made to become part of you" },
    { "type": "richtext", "id": "story_text", "label": "Story text", "default": "<p>We balance expressive notes, considered ingredients, and precise craftsmanship to create lasting fragrances with presence and character. As an online-only house, every touchpoint is designed around a thoughtful, direct relationship with our customers.</p>" },
    { "type": "text", "id": "values_eyebrow", "label": "Values eyebrow", "default": "What guides us" },
    { "type": "text", "id": "values_heading", "label": "Values heading", "default": "Mission, vision, values" },
    { "type": "header", "content": "Story banner" },
    { "type": "image_picker", "id": "banner_desktop_image", "label": "Desktop story banner" },
    { "type": "image_picker", "id": "banner_mobile_image", "label": "Mobile story banner" },
    { "type": "text", "id": "banner_alt", "label": "Banner alt text", "default": "Mista signature fragrance collection" },
    { "type": "text", "id": "banner_eyebrow", "label": "Banner eyebrow", "default": "More than a scent" },
    { "type": "text", "id": "banner_heading", "label": "Banner heading", "default": "A story you can wear" },
    { "type": "richtext", "id": "banner_text", "label": "Banner text", "default": "<p>Discover a fragrance that feels unmistakably yours.</p>" },
    { "type": "text", "id": "banner_label", "label": "Banner button", "default": "Discover our collections" },
    { "type": "url", "id": "banner_link", "label": "Banner link" },
    { "type": "range", "id": "banner_height", "label": "Desktop banner height", "min": 280, "max": 620, "step": 10, "unit": "px", "default": 420 },
    { "type": "range", "id": "banner_mobile_height", "label": "Mobile banner height", "min": 340, "max": 680, "step": 10, "unit": "px", "default": 480 }
  ],
  "blocks": [{ "type": "value", "name": "Value", "limit": 6, "settings": [{ "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "sparkle", "label": "Sparkle" }, { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "heart", "label": "Heart" }], "default": "sparkle" }, { "type": "text", "id": "heading", "label": "Heading", "default": "Our mission" }, { "type": "textarea", "id": "text", "label": "Text", "default": "To make beautifully composed fragrance an expressive part of everyday life." }] }],
  "presets": [{ "name": "Mista about page", "blocks": [{ "type": "value", "settings": { "heading": "Our mission" } }, { "type": "value", "settings": { "heading": "Our vision", "icon": "heart" } }, { "type": "value", "settings": { "heading": "Our values", "icon": "shield" } }] }]
}
{% endschema %}
