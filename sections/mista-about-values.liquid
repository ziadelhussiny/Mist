<section class="mista-section" style="--mista-section-bg:{{ section.settings.background }};--mista-gap:{{ section.settings.gap }}px">
  <div class="mista-shell"><header class="mista-section-head mista-section-head--center"><p class="mista-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.heading }}</h2>{% if section.settings.text != blank %}<div class="mista-copy" style="margin-inline:auto">{{ section.settings.text }}</div>{% endif %}</header><div class="mista-editorial-grid" style="--mista-columns:{{ section.settings.columns }}">{% for block in section.blocks %}<article class="mista-editorial-card" {{ block.shopify_attributes }}>{% render 'mista-icon', name: block.settings.icon %}<h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div>
</section>
{% schema %}
{
  "name": "Mista about values",
  "tag": "section",
  "class": "mista-about-values-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What guides us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mission, vision, values" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Grid gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "color", "id": "background", "label": "Background", "default": "#F7F1E8" }
  ],
  "blocks": [{ "type": "value", "name": "Value", "limit": 8, "settings": [{ "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "sparkle", "label": "Sparkle" }, { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "heart", "label": "Heart" }, { "value": "return", "label": "Time" }], "default": "sparkle" }, { "type": "text", "id": "heading", "label": "Heading", "default": "Our mission" }, { "type": "textarea", "id": "text", "label": "Text", "default": "To make beautifully composed fragrance an expressive part of everyday life." }] }],
  "presets": [{ "name": "Mista about values", "blocks": [{ "type": "value" }, { "type": "value" }, { "type": "value" }] }]
}
{% endschema %}
