{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign featured_media = selected_variant.featured_media | default: product.featured_media
  assign top_notes = product.metafields.custom.top_notes.value | default: section.settings.top_notes_fallback
  assign heart_notes = product.metafields.custom.heart_notes.value | default: section.settings.heart_notes_fallback
  assign base_notes = product.metafields.custom.base_notes.value | default: section.settings.base_notes_fallback
  assign product_form_id = 'MistaProductForm-' | append: section.id
%}
<section class="mista-product" data-mista-product data-money-format="{{ shop.money_format | escape }}">
  <div class="mista-shell">
    {% if section.settings.show_breadcrumb %}
      <nav class="mista-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span>/</span>
        {% if product.collections.first %}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a><span>/</span>{% endif %}
        <span aria-current="page">{{ product.title }}</span>
      </nav>
    {% endif %}
    <div class="mista-product__grid{% if section.settings.media_position == 'right' %} mista-product__grid--media-right{% endif %}">
      <div class="mista-gallery{% unless section.settings.show_thumbnails %} mista-gallery--without-thumbnails{% endunless %}" data-mista-gallery>
        {% if section.settings.show_thumbnails %}
          <div class="mista-gallery__thumbs" role="list" aria-label="Product images">
            {% for media in product.media %}
              {% if media.media_type == 'image' %}
                <button type="button" class="mista-gallery__thumb" data-mista-gallery-thumb data-src="{{ media | image_url: width: 1400 }}" data-srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="View image {{ forloop.index }}" aria-current="{% if media.id == featured_media.id %}true{% else %}false{% endif %}">{{ media | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', alt: media.alt | default: product.title }}</button>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        <div class="mista-gallery__main">
          {% if featured_media %}
            <img src="{{ featured_media | image_url: width: 1200 }}" srcset="{{ featured_media | image_url: width: 600 }} 600w, {{ featured_media | image_url: width: 900 }} 900w, {{ featured_media | image_url: width: 1200 }} 1200w, {{ featured_media | image_url: width: 1800 }} 1800w" sizes="(min-width: 768px) 55vw, 100vw" width="{{ featured_media.preview_image.width }}" height="{{ featured_media.preview_image.height }}" alt="{{ featured_media.alt | default: product.title | escape }}" loading="eager" fetchpriority="high" data-mista-gallery-main>
          {% else %}
            <img src="{{ 'mista-product-black-900.webp' | asset_url }}" srcset="{{ 'mista-product-black-360.webp' | asset_url }} 360w, {{ 'mista-product-black-640.webp' | asset_url }} 640w, {{ 'mista-product-black-900.webp' | asset_url }} 900w, {{ 'mista-product-black.webp' | asset_url }} 1122w" sizes="(min-width: 768px) 55vw, 100vw" width="1122" height="1402" loading="eager" fetchpriority="high" decoding="sync" alt="Mista black perfume bottle with gold monogram" data-mista-gallery-main>
          {% endif %}
        </div>
      </div>

      <div class="mista-product__info" style="--mista-product-block-gap:{{ section.settings.block_gap }}px">
        {% form 'product', product, id: product_form_id, class: 'mista-product-form', data-mista-ajax-cart: '' %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}">
          <script type="application/json" data-mista-variants>{{ product.variants | json }}</script>

          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'title' %}
                <div class="mista-product-block mista-product-block--title" {{ block.shopify_attributes }}>
                  <div class="mista-product__title-row">
                    <div>
                      {% if block.settings.show_vendor %}<p class="mista-eyebrow">{{ product.vendor | default: 'Mista Perfume' }}</p>{% endif %}
                      <h1 class="mista-product__title">{{ product.title }}</h1>
                    </div>
                    {% if block.settings.show_badge %}
                      {% if product.tags contains 'Best Seller' %}<span class="mista-badge">Best Seller</span>{% elsif product.tags contains 'New' %}<span class="mista-badge">New</span>{% endif %}
                    {% endif %}
                  </div>
                </div>

              {% when 'rating' %}
                <div class="mista-product-block mista-product-block--rating" {{ block.shopify_attributes }}>
                  <div class="mista-stars"><span aria-hidden="true">★★★★★</span>{% if block.settings.show_count and product.metafields.reviews.rating_count.value %}<small>({{ product.metafields.reviews.rating_count.value }} reviews)</small>{% endif %}</div>
                </div>

              {% when 'price' %}
                <div class="mista-product-block mista-product-block--price" {{ block.shopify_attributes }}>
                  <div class="mista-product__prices"><strong data-mista-price>{{ selected_variant.price | money }}</strong><s data-mista-compare-price {% unless selected_variant.compare_at_price > selected_variant.price %}hidden{% endunless %}>{% if selected_variant.compare_at_price > selected_variant.price %}{{ selected_variant.compare_at_price | money }}{% endif %}</s></div>
                </div>

              {% when 'description' %}
                {% if product.description != blank %}
                  <div class="mista-product-block mista-product-block--description" {{ block.shopify_attributes }}>
                    <div class="mista-product__description">{% if block.settings.show_full_description %}{{ product.description }}{% else %}{{ product.description | strip_html | truncatewords: block.settings.words }}{% endif %}</div>
                  </div>
                {% endif %}

              {% when 'variant_picker' %}
                <div class="mista-product-block mista-product-block--variants" {{ block.shopify_attributes }}>
                  {% unless product.has_only_default_variant %}
                    <div class="mista-options">
                      {% for option in product.options_with_values %}
                        <fieldset>
                          <legend>{{ option.name }}</legend>
                          <div class="mista-options__list">
                            {% for value in option.values %}
                              <label class="mista-pill" for="MistaOption-{{ section.id }}-{{ block.id }}-{{ option.position }}-{{ forloop.index }}"><input id="MistaOption-{{ section.id }}-{{ block.id }}-{{ option.position }}-{{ forloop.index }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-mista-option {% if value.selected %}checked{% endif %}>{{ value }}</label>
                            {% endfor %}
                          </div>
                        </fieldset>
                      {% endfor %}
                    </div>
                  {% endunless %}
                </div>

              {% when 'buy_buttons' %}
                <div class="mista-product-block mista-product-block--buy" {{ block.shopify_attributes }}>
                  {% if block.settings.show_quantity %}<label class="mista-eyebrow" for="MistaQuantity-{{ section.id }}-{{ block.id }}">{{ block.settings.quantity_label }}</label>{% endif %}
                  <div class="mista-quantity-row{% unless block.settings.show_quantity %} mista-quantity-row--single{% endunless %}">
                    {% if block.settings.show_quantity %}
                      <div class="mista-quantity"><button type="button" data-mista-quantity="-1" aria-controls="MistaQuantity-{{ section.id }}-{{ block.id }}" aria-label="Decrease quantity">{% render 'mista-icon', name: 'minus' %}</button><input id="MistaQuantity-{{ section.id }}-{{ block.id }}" name="quantity" type="number" min="1" value="1" inputmode="numeric" aria-label="Quantity"><button type="button" data-mista-quantity="1" aria-controls="MistaQuantity-{{ section.id }}-{{ block.id }}" aria-label="Increase quantity">{% render 'mista-icon', name: 'plus' %}</button></div>
                    {% endif %}
                    <button class="mista-button mista-button--gold" type="submit" data-mista-add data-available-label="{{ section.settings.add_label }}" data-sold-label="{{ section.settings.sold_label }}" data-loading-label="Adding…" data-added-label="Added" {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}{{ section.settings.add_label }}{% else %}{{ section.settings.sold_label }}{% endif %}</button>
                  </div>
                  {% if block.settings.show_buy_now %}<button class="mista-button mista-button--primary mista-buy-now" type="submit" name="checkout" {% unless selected_variant.available %}disabled{% endunless %}>{{ section.settings.buy_label }}</button>{% endif %}
                  <p class="mista-form-status" data-mista-form-status role="status"></p>
                </div>

              {% when 'trust_badges' %}
                <div class="mista-product-block mista-product-block--trust" {{ block.shopify_attributes }}>
                  <div class="mista-trust-row">
                    {% if block.settings.show_shipping %}<div class="mista-trust-item">{% render 'mista-icon', name: 'truck' %}<span>{{ block.settings.shipping_text }}</span></div>{% endif %}
                    {% if block.settings.show_payment %}<div class="mista-trust-item">{% render 'mista-icon', name: 'shield' %}<span>{{ block.settings.payment_text }}</span></div>{% endif %}
                    {% if block.settings.show_returns %}<div class="mista-trust-item">{% render 'mista-icon', name: 'return' %}<span>{{ block.settings.returns_text }}</span></div>{% endif %}
                  </div>
                </div>

              {% when 'accordion' %}
                {% assign accordion_id = 'MistaAccordion-' | append: section.id | append: '-' | append: block.id %}
                <div class="mista-product-block mista-product-block--accordion mista-accordion" {{ block.shopify_attributes }}>
                  <button class="mista-accordion__button" type="button" data-mista-accordion-button aria-expanded="{{ block.settings.open_by_default }}" aria-controls="{{ accordion_id }}"><span>{{ block.settings.heading }}{% if block.settings.content_source == 'reviews' and product.metafields.reviews.rating_count.value %} ({{ product.metafields.reviews.rating_count.value }}){% endif %}</span>{% render 'mista-icon', name: 'chevron' %}</button>
                  <div id="{{ accordion_id }}" class="mista-accordion__panel" {% unless block.settings.open_by_default %}hidden{% endunless %}>
                    {% case block.settings.content_source %}
                      {% when 'product_description' %}{{ product.description }}
                      {% when 'reviews' %}{{ block.settings.content }}
                      {% else %}{{ block.settings.content }}
                    {% endcase %}
                  </div>
                </div>

              {% when 'fragrance_notes' %}
                <div class="mista-product-block mista-product-block--notes" {{ block.shopify_attributes }}>
                  <div class="mista-notes" aria-label="Fragrance notes">
                    {% if block.settings.show_top %}<div class="mista-note-card">{% render 'mista-icon', name: 'leaf' %}<strong>{{ block.settings.top_label }}</strong><span>{{ top_notes }}</span></div>{% endif %}
                    {% if block.settings.show_heart %}<div class="mista-note-card">{% render 'mista-icon', name: 'heart' %}<strong>{{ block.settings.heart_label }}</strong><span>{{ heart_notes }}</span></div>{% endif %}
                    {% if block.settings.show_base %}<div class="mista-note-card">{% render 'mista-icon', name: 'sparkle' %}<strong>{{ block.settings.base_label }}</strong><span>{{ base_notes }}</span></div>{% endif %}
                  </div>
                </div>

              {% when 'custom_liquid' %}
                <div class="mista-product-block mista-product-block--custom" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

              {% when '@app' %}
                <div class="mista-product-block mista-product-block--app" {{ block.shopify_attributes }}>{% render block %}</div>
            {% endcase %}
          {% endfor %}
        {% endform %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Mista product information",
  "tag": "section",
  "class": "mista-main-product-section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "checkbox", "id": "show_thumbnails", "label": "Show image thumbnails", "default": true },
    { "type": "select", "id": "media_position", "label": "Media position on desktop", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "block_gap", "label": "Space between information blocks", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Button labels" },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "sold_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "buy_label", "label": "Buy now label", "default": "Buy it now" },
    { "type": "header", "content": "Fragrance note fallbacks" },
    { "type": "text", "id": "top_notes_fallback", "label": "Top notes fallback", "default": "Bergamot, lychee, pear" },
    { "type": "text", "id": "heart_notes_fallback", "label": "Heart notes fallback", "default": "Rose, peony, jasmine" },
    { "type": "text", "id": "base_notes_fallback", "label": "Base notes fallback", "default": "Sandalwood, musk, amber" }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true }, { "type": "checkbox", "id": "show_badge", "label": "Show product badge", "default": true }] },
    { "type": "rating", "name": "Rating", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_count", "label": "Show review count", "default": true }] },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_full_description", "label": "Show full description", "default": false }, { "type": "range", "id": "words", "label": "Words when shortened", "min": 15, "max": 100, "step": 5, "default": 45 }] },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "buy_buttons", "name": "Quantity and buy buttons", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true }, { "type": "text", "id": "quantity_label", "label": "Quantity label", "default": "Quantity" }, { "type": "checkbox", "id": "show_buy_now", "label": "Show buy now button", "default": true }] },
    { "type": "trust_badges", "name": "Trust badges", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_shipping", "label": "Show shipping", "default": true }, { "type": "text", "id": "shipping_text", "label": "Shipping text", "default": "Free shipping on orders over $75" }, { "type": "checkbox", "id": "show_payment", "label": "Show secure payment", "default": true }, { "type": "text", "id": "payment_text", "label": "Payment text", "default": "Secure payment" }, { "type": "checkbox", "id": "show_returns", "label": "Show returns", "default": true }, { "type": "text", "id": "returns_text", "label": "Returns text", "default": "Easy returns" }] },
    { "type": "accordion", "name": "Collapsible row", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Product details" }, { "type": "select", "id": "content_source", "label": "Content source", "options": [{ "value": "product_description", "label": "Product description" }, { "value": "custom", "label": "Custom content" }, { "value": "reviews", "label": "Reviews" }], "default": "custom" }, { "type": "richtext", "id": "content", "label": "Custom content", "default": "<p>Add your content here.</p>" }, { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }] },
    { "type": "fragrance_notes", "name": "Fragrance notes", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_top", "label": "Show top notes", "default": true }, { "type": "text", "id": "top_label", "label": "Top notes label", "default": "Top notes" }, { "type": "checkbox", "id": "show_heart", "label": "Show heart notes", "default": true }, { "type": "text", "id": "heart_label", "label": "Heart notes label", "default": "Heart notes" }, { "type": "checkbox", "id": "show_base", "label": "Show base notes", "default": true }, { "type": "text", "id": "base_label", "label": "Base notes label", "default": "Base notes" }] },
    { "type": "custom_liquid", "name": "Custom Liquid", "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" }] },
    { "type": "@app" }
  ],
  "max_blocks": 30
}
{% endschema %}
