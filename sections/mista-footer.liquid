<section class="mista-footer">
  <div class="mista-shell">

    <div class="mista-footer__grid">

      <div class="mista-footer__brand">
        <span class="mista-monogram" aria-hidden="true">M</span>
        <strong class="mista-wordmark">MISTA</strong>
        <p>{{ section.settings.description }}</p>
      </div>

      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>

          <ul>
            {% for link in block.settings.menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}

    </div>

    <div class="mista-footer__bottom">

      <div class="mista-footer__copyright">

        <span>
          © {{ 'now' | date: '%Y' }} {{ shop.name }}.
          {{ section.settings.copyright }}
        </span>

        <small class="copyright__content">
          <a
            href="https://www.instagram.com/_zealnx?igsh=azBlcmt6cGxiNWt6"
            target="_blank"
            rel="noopener noreferrer"
            class="zealnx-credit"
          >
            Developed by <strong>Zealnx</strong>
          </a>
        </small>

      </div>

      <div class="mista-footer__socials">

        {% if settings.mista_instagram != blank %}
          <a
            href="{{ settings.mista_instagram }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        {% endif %}

        {% if settings.mista_facebook != blank %}
          <a
            href="{{ settings.mista_facebook }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook
          </a>
        {% endif %}

        {% if settings.mista_tiktok != blank %}
          <a
            href="{{ settings.mista_tiktok }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            TikTok
          </a>
        {% endif %}

        {% for policy in shop.policies %}
          {% if policy != blank %}
            <a href="{{ policy.url }}">
              {{ policy.title }}
            </a>
          {% endif %}
        {% endfor %}

      </div>

    </div>

  </div>
</section>


<style>

  .mista-footer__copyright {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .copyright__content {
    font-size: inherit;
  }

  .zealnx-credit {
    color: #F5FF00;
    text-decoration: none;
    font-weight: 400;
    transition: opacity 0.2s ease;
  }

  .zealnx-credit strong {
    color: #F5FF00;
    font-weight: 700;
  }

  .zealnx-credit:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {

    .mista-footer__copyright {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

  }

</style>


{% schema %}
{
  "name": "Mista footer",
  "tag": "section",
  "class": "mista-footer-section",
  "limit": 1,

  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand description",
      "default": "Modern fragrance, thoughtfully composed. Mista is an online-only perfume house made for everyday rituals."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "All rights reserved."
    }
  ],

  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,

      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Mista footer",
      "blocks": [
        {
          "type": "menu"
        },
        {
          "type": "menu"
        },
        {
          "type": "menu"
        }
      ]
    }
  ]
}
{% endschema %}