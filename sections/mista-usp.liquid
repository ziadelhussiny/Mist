<section class="mista-usp">
  <div class="mista-shell mista-usp__grid" style="--mista-columns:{{ section.settings.columns }}">
    {% for block in section.blocks %}
      <div class="mista-usp__item" {{ block.shopify_attributes }}>
        {% render 'mista-icon', name: block.settings.icon %}<div><strong>{{ block.settings.heading }}</strong><span>{{ block.settings.text }}</span></div>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Mista USP features",
  "tag": "section",
  "class": "mista-usp-section",
  "settings": [{ "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 4 }],
  "blocks": [
    { "type": "feature", "name": "Feature", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "return", "label": "Time" }, { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Truck" }, { "value": "star", "label": "Star" }], "default": "leaf" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Premium quality" },
      { "type": "text", "id": "text", "label": "Text", "default": "Finest ingredients" }
    ] }
  ],
  "presets": [{ "name": "Mista USP features", "blocks": [{ "type": "feature", "settings": { "icon": "leaf", "heading": "Premium quality", "text": "Finest ingredients" } }, { "type": "feature", "settings": { "icon": "return", "heading": "Long lasting", "text": "All-day performance" } }, { "type": "feature", "settings": { "icon": "shield", "heading": "Secure payment", "text": "100% secure checkout" } }, { "type": "feature", "settings": { "icon": "truck", "heading": "Free shipping", "text": "On orders over $75" } }] }]
}
{% endschema %}
