<section class="mista-section" style="--mista-section-bg:{{ section.settings.background }};--mista-gap:{{ section.settings.gap }}px">
  <div class="mista-shell">
    <header class="mista-section-head"><div><p class="mista-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.heading }}</h2></div>{% if section.settings.button_label != blank %}<a class="mista-button mista-button--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</header>
    <div class="mista-collection-grid" style="--mista-columns:{{ section.settings.columns }}">
      {% for block in section.blocks %}
        {% assign featured_collection = block.settings.collection %}
        {% liquid
          case forloop.index
            when 1
              assign default_collection_image = 'mista-product-black.png'
            when 2
              assign default_collection_image = 'mista-product-pink.png'
            when 3
              assign default_collection_image = 'mista-product-orange.png'
            else
              assign default_collection_image = 'mista-product-turquoise.png'
          endcase
        %}
        <a class="mista-collection-card" href="{{ featured_collection.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360,540,760,1000,1200', sizes: '(min-width: 768px) 33vw, 50vw', alt: block.settings.title | default: featured_collection.title }}{% elsif featured_collection.featured_image %}{{ featured_collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360,540,760,1000,1200', sizes: '(min-width: 768px) 33vw, 50vw', alt: featured_collection.title }}{% else %}<img src="{{ default_collection_image | asset_url }}" width="1120" height="1400" loading="lazy" alt="{{ block.settings.title | default: 'Mista perfume collection' | escape }}">{% endif %}
          <span class="mista-collection-card__overlay"></span><span class="mista-collection-card__content"><h3>{{ block.settings.title | default: featured_collection.title | default: 'Signature scents' }}</h3><span>{{ block.settings.link_label }}</span></span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Mista collections",
  "tag": "section",
  "class": "mista-collections-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your signature" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our collections" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "View all" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "gap", "label": "Grid gap", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "color", "id": "background", "label": "Background", "default": "#F7F1E8" }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "limit": 6, "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }, { "type": "image_picker", "id": "image", "label": "Override image" }, { "type": "text", "id": "title", "label": "Override title" }, { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore collection" }] }
  ],
  "presets": [{ "name": "Mista collections", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
