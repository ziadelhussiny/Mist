<section class="mista-banner" style="--mista-banner-height:{{ section.settings.height }}px;--mista-banner-mobile-height:{{ section.settings.mobile_height }}px">
  <div class="mista-banner__media">{% if section.settings.desktop_image != blank %}<picture>{% if section.settings.mobile_image != blank %}<source media="(max-width:767px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.desktop_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: section.settings.image_alt }}</picture>{% else %}<picture><source media="(max-width:767px)" srcset="{{ 'mista-promo-mobile.png' | asset_url }}"><img src="{{ 'mista-promo-desktop.png' | asset_url }}" width="1672" height="940" loading="lazy" alt="{{ section.settings.image_alt | escape }}"></picture>{% endif %}</div>
  <div class="mista-banner__overlay" style="opacity:{{ section.settings.overlay | divided_by: 100.0 }}"></div><div class="mista-banner__content"><div><p class="mista-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="mista-heading mista-heading--section">{{ section.settings.heading }}</h2><div class="mista-copy">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="mista-button mista-button--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></div>
</section>
{% schema %}
{
  "name": "Mista about banner",
  "tag": "section",
  "class": "mista-about-banner-section",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop banner image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile banner image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Mista black perfume bottle with gold monogram" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More than a scent" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A story you can wear" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover a fragrance that feels unmistakably yours.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover our collections" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 280, "max": 620, "step": 10, "unit": "px", "default": 420 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 340, "max": 680, "step": 10, "unit": "px", "default": 480 },
    { "type": "range", "id": "overlay", "label": "Overlay strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "Mista about banner" }]
}
{% endschema %}
