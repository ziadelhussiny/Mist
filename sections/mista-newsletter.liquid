<section class="mista-newsletter" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
  <div class="mista-shell mista-newsletter__inner">
    {% if section.settings.eyebrow != blank %}<p class="mista-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2 class="mista-heading mista-heading--section">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<div class="mista-copy" style="margin-inline:auto">{{ section.settings.text }}</div>{% endif %}
    {% form 'customer', class: 'mista-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="MistaNewsletter-{{ section.id }}">Email address</label>
      <input id="MistaNewsletter-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ section.settings.placeholder }}" autocomplete="email" autocorrect="off" autocapitalize="off" required>
      <button class="mista-button mista-button--primary" type="submit">{{ section.settings.button_label }}</button>
      {% if form.posted_successfully? %}<p class="mista-newsletter__message" role="status">{{ section.settings.success_message }}</p>{% endif %}
      {% if form.errors %}<div class="mista-newsletter__message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "Mista newsletter",
  "tag": "section",
  "class": "mista-newsletter-section",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in the loop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little luxury, delivered" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Be the first to discover new scents, private offers, and stories from Mista.</p>" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Welcome to Mista." },
    { "type": "color", "id": "background", "label": "Background", "default": "#E8D8C3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#242424" }
  ],
  "presets": [{ "name": "Mista newsletter" }]
}
{% endschema %}
